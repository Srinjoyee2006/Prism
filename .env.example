# LLM Endpoint (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Audio & Speech Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=512

# VAD Settings
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=400

# TTS Engine (Local / Zero-Cost)
TTS_ENGINE=kokoro
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart

# Tool Commit Gate Settings
COMMIT_GATE_CONFIDENCE_THRESHOLD=0.85
COMMIT_GATE_TIMEOUT_MS=800

# LiveKit WebRTC Transport (Stage 7)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Logging & Debugging
LOG_LEVEL=INFO
DEBUG_AUDIO_DUMP=false
